DIRECT_URL=

# scripts/seed-admin.js (bootstrap local, não roda em produção)
SEED_COMPANY_NAME=
SEED_COMPANY_SLUG=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
