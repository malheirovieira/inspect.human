# Copie para .env.local e preencha com os valores do seu projeto Supabase
# (Project Settings → API e Project Settings → Database).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Connection string do Postgres (Project Settings → Database → Connection string)
DATABASE_URL=
DIRECT_URL=

# Fila de tarefas (lib/tasks): Bearer da rota /api/cron/tasks. Mesmo valor
# na Vercel e no Supabase Vault (supabase/cron/process_tasks.sql). Sem ele a
# rota responde 503. Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Triagem com IA (lib/ai). Sem AI_PROVIDER = "mock" (não chama API nenhuma,
# devolve exemplo simulado). Nenhuma destas vai pro navegador.
# AI_MODEL é obrigatório pra gemini/openai — confira o nome atual na doc do
# provedor (ex. em set/2026: gemini-3.8-flash, gpt-6-luna).
AI_PROVIDER=
AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
# "true" libera candidatos REAIS. Deixe false (ou vazio) no plano gratuito
# de qualquer provedor — os termos do Gemini free proíbem dado pessoal.
AI_ALLOW_REAL_DATA=false

# Testes de integração (npm run test:db) — SEGUNDO projeto Supabase, só de
# teste. Nunca o mesmo projeto de DATABASE_URL (os testes apagam a fila).
# TEST_DATABASE_URL: transaction pooler (porta 6543), igual à produção.
# TEST_DIRECT_URL: session pooler (porta 5432), só pro npm run test:db:setup.
TEST_DATABASE_URL=
TEST_DIRECT_URL=

# scripts/seed-admin.js (bootstrap local, não roda em produção)
SEED_COMPANY_NAME=
SEED_COMPANY_SLUG=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
