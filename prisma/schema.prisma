// Espelha supabase/schema.sql. Escrito à mão (não introspectado) porque
// `users.id` referencia `auth.users` (schema interno do Supabase Auth), que
// o Prisma não gerencia — a aplicação usa o mesmo UUID dos dois lados.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

// Stub só para satisfazer a validação de FK entre schemas (public.users →
// auth.users). O Prisma nunca cria/migra/consulta esta tabela — ela é
// inteiramente gerenciada pelo Supabase Auth.
model AuthUser {
  id String @id @db.Uuid

  @@map("users")
  @@schema("auth")
  @@ignore
}

model Company {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  active      Boolean  @default(true)
  // Endereço estruturado (Sprint 1 — multipostagem/SEO) — opcional, usado só
  // pra montar o jobLocation.address do JobPosting JSON-LD. Sem isso
  // preenchido, a vaga pública sai sem address_street/city/state/zip (o
  // JSON-LD cai pro fallback de só país).
  addressStreet  String? @map("address_street")
  addressCity    String? @map("address_city")
  addressState   String? @map("address_state")
  addressZip     String? @map("address_zip")
  addressCountry String? @default("BR") @map("address_country")
  // Parametrização — integrações de divulgação de vagas (Configurações >
  // Parametrização). Indeed é self-service (e-mail da conta de empregador);
  // LinkedIn e InfoJobs exigem parceria comercial prévia da Inspect Talent —
  // o campo pode ser preenchido desde já, mas só funciona de verdade quando
  // a flag global correspondente (env var, ver lib/config/jobBoards.ts)
  // estiver ligada. Jooble e Google não têm campo (ver mesmo arquivo).
  indeedEmployerEmail String? @map("indeed_employer_email")
  linkedinCompanyId   String? @map("linkedin_company_id")
  infojobsId          String? @map("infojobs_id")
  // Plano (id de lib/plans.ts — hoje PLACEHOLDER). Sem check constraint:
  // valor desconhecido cai no plano básico (getPlan). Sem cobrança ainda.
  plan        String   @default("essencial")
  // Chave "Triagem com IA" (Configurações). Desligada por padrão e bloqueada
  // enquanto AI_ALLOW_REAL_DATA=false (ver lib/ai).
  aiScreeningEnabled   Boolean   @default(false) @map("ai_screening_enabled")
  aiScreeningChangedAt DateTime? @map("ai_screening_changed_at") @db.Timestamptz(6)
  aiScreeningChangedById String? @map("ai_screening_changed_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  aiScreeningChangedBy User? @relation("CompanyAiScreeningChangedBy", fields: [aiScreeningChangedById], references: [id], onDelete: SetNull)

  users               User[]
  jobs                Job[]
  candidates          Candidate[]
  applications        Application[]
  applicationEvents   ApplicationEvent[]
  trainingTrails      TrainingTrail[]
  trainingItems       TrainingItem[]
  trainingAssignments TrainingAssignment[]
  trainingProgress    TrainingProgress[]
  companyOptions      CompanyOption[]
  employeeExits       EmployeeExit[]
  kanbanStageLabels   KanbanStageLabel[]
  employeeDocuments   EmployeeDocument[]
  notifications       Notification[]
  backgroundTasks     BackgroundTask[]
  candidateResumes    CandidateResume[]
  resumeAnalyses      ResumeAnalysis[]
  consents            Consent[]
  emailTemplates      EmailTemplate[]
  discAssessments     DiscAssessment[]
  discResponses       DiscResponse[]
  discAnswers         DiscAnswer[]
  quizAssessments     QuizAssessment[]
  quizResponses       QuizResponse[]
  aiConfig            CompanyAiConfig?
  exitSurveyResponses ExitSurveyResponse[]

  @@map("companies")
  @@schema("public")
}

// Parametrização de IA por empresa (BYOK, Fase 1) — uma linha por empresa
// (companyId único: a empresa tem UM provider ativo por vez). apiKeyEncrypted
// NUNCA guarda texto puro (AES-256-GCM, ver lib/ai/credentials.ts) e nunca é
// devolvida ao cliente em nenhuma resposta — só o indicador mascarado
// (ver lib/ai/credentials.ts maskApiKey). Sem config própria, a triagem usa
// a chave da plataforma (fallback, ver lib/ai/resolveConfig.ts).
model CompanyAiConfig {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String   @unique @map("company_id") @db.Uuid
  provider         String   // "anthropic" | "openai" | "gemini"
  apiKeyEncrypted  String   @map("api_key_encrypted")
  model            String
  enabled          Boolean  @default(true)
  // Preparação pra integração futura com ERP — não implementado agora.
  dataSource       String   @default("manual") @map("data_source")
  externalRef      String?  @map("external_ref")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_ai_configs")
  @@schema("public")
}

// Listas configuráveis pela empresa (Configurações): setor, horário de
// trabalho, modalidade de contratação. Um único modelo genérico em vez de
// uma tabela por categoria — mesma forma, mais simples de manter.
model CompanyOption {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  category  String
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, category, label])
  @@index([companyId, category])
  @@map("company_options")
  @@schema("public")
}

model User {
  // Mesmo UUID de auth.users(id) — nunca gerado pelo Prisma, sempre vindo do
  // Supabase Auth no momento em que o usuário é criado/convidado.
  id        String   @id @db.Uuid
  // Opcional só pra SUPERADMIN (dono do sistema, não de uma empresa) —
  // ON DELETE SET NULL (migration 0034), não CASCADE como o resto do schema.
  companyId String?  @map("company_id") @db.Uuid
  name      String
  email     String
  role      String
  active    Boolean  @default(true)
  // Ligado sempre que o acesso é criado com senha temporária gerada pelo
  // sistema (inviteUser, createColaborador) — força a troca antes de
  // liberar qualquer rota do dashboard (ver app/(dashboard)/layout.tsx e
  // app/trocar-senha/). Nunca fica true em contas que definiram a própria
  // senha (ex.: /cadastro).
  mustChangePassword Boolean @default(false) @map("must_change_password")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  // ---- Ficha de colaborador (cadastro RH) — todos opcionais no banco;
  // obrigatoriedade é decidida no schema de validação (schemas/colaborador.ts).
  // 1. Dados pessoais básicos
  birthDate           DateTime? @map("birth_date") @db.Date
  sex                 String?   @map("sex")
  nationality         String?   @map("nationality")
  birthplace          String?   @map("birthplace")
  maritalStatus       String?   @map("marital_status")
  motherName          String?   @map("mother_name")
  fatherName          String?   @map("father_name")
  addressZip          String?   @map("address_zip")
  addressStreet       String?   @map("address_street")
  addressNumber       String?   @map("address_number")
  addressComplement   String?   @map("address_complement")
  addressNeighborhood String?   @map("address_neighborhood")
  addressCity         String?   @map("address_city")
  addressState        String?   @map("address_state")
  phone               String?   @map("phone")
  educationLevel      String?   @map("education_level")
  raceColor           String?   @map("race_color")

  // 2. Documentos de identificação
  cpf                  String? @map("cpf")
  idDocumentType       String? @map("id_document_type")
  idDocumentNumber     String? @map("id_document_number")
  ctpsNumber           String? @map("ctps_number")
  pisNumber            String? @map("pis_number")
  voterTitleNumber     String? @map("voter_title_number")
  reservistCertificate String? @map("reservist_certificate")
  civilRegistryType    String? @map("civil_registry_type")
  civilRegistryNumber  String? @map("civil_registry_number")

  // 3. Dados profissionais e contratuais
  department         String?   @map("department")
  position           String?   @map("position")
  admissionDate      DateTime? @map("admission_date") @db.Date
  salary             Decimal?  @map("salary") @db.Decimal(12, 2)
  workSchedule       String?   @map("work_schedule")
  registrationNumber String?   @map("registration_number")

  // 4. Dados bancários e benefícios
  bankName               String?  @map("bank_name")
  bankAgency             String?  @map("bank_agency")
  bankAccount            String?  @map("bank_account")
  transportVoucherOptIn  Boolean? @map("transport_voucher_opt_in")
  dependents             Json?    @map("dependents")

  // 5. Saúde ocupacional
  admissionExamDate   DateTime? @map("admission_exam_date") @db.Date
  admissionExamResult String?   @map("admission_exam_result")

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdJobs         Job[]                @relation("JobCreatedBy")
  trainingAssignments TrainingAssignment[]
  exit                EmployeeExit?        @relation("ExitUser")
  processedExits      EmployeeExit[]       @relation("ExitCreatedBy")
  documents           EmployeeDocument[]
  applicationEvents   ApplicationEvent[]   @relation("ApplicationEventActor")
  uploadedResumes     CandidateResume[]    @relation("ResumeUploadedBy")
  editedAnalyses      ResumeAnalysis[]     @relation("AnalysisSkillsEditedBy")
  aiScreeningChanges  Company[]            @relation("CompanyAiScreeningChangedBy")
  consents            Consent[]            @relation("ConsentUser")

  @@unique([companyId, email])
  @@unique([companyId, cpf])
  @@index([companyId])
  @@index([companyId, active])
  @@map("users")
  @@schema("public")
}

model Job {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  title          String
  description    String
  department     String?
  location       String?
  workMode       String   @map("work_mode")
  employmentType String?  @map("employment_type")
  status         String   @default("DRAFT")
  // Primeira vez que a vaga virou OPEN — usado pro KPI de time-to-hire.
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  // Cronograma planejado da vaga — datas de referência, nada é fechado
  // automaticamente quando elas passam (é só informativo pro RH por
  // enquanto).
  resumeDeadline    DateTime? @map("resume_deadline") @db.Date
  interviewDeadline DateTime? @map("interview_deadline") @db.Date
  hiringDeadline    DateTime? @map("hiring_deadline") @db.Date
  expectedStartDate DateTime? @map("expected_start_date") @db.Date
  // Sprint 1 (multipostagem/SEO) — expiração da vaga pro JobPosting
  // JSON-LD (Google trata como obrigatório na prática). Configurável no
  // formulário, sugestão de 30 dias calculada no cliente; sem valor, a
  // vaga sai do JSON-LD sem validThrough (campo opcional do schema.org,
  // mas penalizado pelo Google sem ele).
  validThrough   DateTime? @map("valid_through") @db.Timestamptz(6)
  // Parametrização — onde esta vaga específica deve ser divulgada (opt-in,
  // default false). Controla: geração do JSON-LD pro Google
  // (publishGoogle), inclusão nos feeds de Indeed/Jooble, e reserva o dado
  // pra quando LinkedIn/InfoJobs ficarem ativos de verdade.
  publishGoogle    Boolean @default(false) @map("publish_google")
  publishIndeed    Boolean @default(false) @map("publish_indeed")
  publishJooble    Boolean @default(false) @map("publish_jooble")
  publishLinkedin  Boolean @default(false) @map("publish_linkedin")
  publishInfojobs  Boolean @default(false) @map("publish_infojobs")
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  applications Application[]

  @@index([companyId])
  @@index([companyId, status])
  @@map("jobs")
  @@schema("public")
}

// A PESSOA — independente de vaga. Uma mesma pessoa pode ter várias
// candidaturas (Application) ao longo do tempo, inclusive em vagas
// diferentes ("banco de talentos"). Campos aqui são os que fazem sentido
// reaproveitar entre candidaturas (currículo, contato). Anotações não moram
// mais aqui — viraram evento (NOTE_ADDED) em ApplicationEvent, por
// candidatura, não pela pessoa (ver aba "Candidatura").
model Candidate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  email       String
  phone       String?
  linkedinUrl String?  @map("linkedin_url")
  // LEGADO (arquivo único por pessoa, sobrescrito a cada upload). Não gravar
  // mais — currículo agora é versionado em CandidateResume. Só lido como
  // fallback até o backfill (scripts/backfill-resume-versions.js); sai na
  // próxima migration livre (a 0023 virou o plano da empresa).
  resumePath  String?  @map("resume_path")
  // Versão ATUAL do currículo da pessoa (perfil). null = sem currículo.
  currentResumeId String? @map("current_resume_id") @db.Uuid
  // Candidato fictício (testes/demonstração). Só ADMIN edita. Enquanto
  // AI_ALLOW_REAL_DATA=false, só estes passam pela triagem com IA.
  isTest      Boolean  @default(false) @map("is_test")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currentResume CandidateResume?  @relation("CandidateCurrentResume", fields: [currentResumeId], references: [id], onDelete: SetNull)
  resumes       CandidateResume[] @relation("CandidateResumes")
  applications  Application[]
  consents      Consent[]

  @@index([companyId])
  @@index([companyId, email])
  @@map("candidates")
  @@schema("public")
}

// A CANDIDATURA de um Candidate a UMA vaga específica — pipeline/etapa,
// tag de qualificação e processo pertencem aqui, não à pessoa.
model Application {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  candidateId String   @map("candidate_id") @db.Uuid
  jobId       String   @map("job_id") @db.Uuid
  stage       String   @default("TRIAGE")
  // Posição manual dentro da coluna do Kanban (etapa) — usada no modo de
  // ordenação "Manual" pra saber quem fica em cima/embaixo.
  position    Int      @default(0)
  // Tag manual de qualificação (GREEN/YELLOW/BLUE/RED/GRAY) — independente
  // da etapa do pipeline, ver schemas/candidate.ts.
  qualificationTag String? @map("qualification_tag")
  // Preenchido só na primeira vez que o estágio vira HIRED — usado pro KPI
  // de time-to-hire (não usar updatedAt, que muda a cada edição qualquer).
  hiredAt     DateTime? @map("hired_at") @db.Timestamptz(6)
  // Versão do currículo ENVIADA com esta candidatura — registro histórico,
  // gravado uma vez e nunca atualizado (versão nova da pessoa não mexe aqui).
  // null = candidatura sem currículo, ou anterior ao versionamento.
  resumeId    String?  @map("resume_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume    CandidateResume? @relation("ApplicationResume", fields: [resumeId], references: [id], onDelete: SetNull)
  events    ApplicationEvent[]
  consents  Consent[]
  emailLogs EmailLog[]
  interviews Interview[]
  discResponses DiscResponse[]
  quizResponses QuizResponse[]

  @@index([companyId])
  @@index([companyId, jobId])
  @@index([companyId, jobId, stage])
  @@index([companyId, candidateId])
  @@map("applications")
  @@schema("public")
}

// VERSÃO do currículo de uma pessoa. Criada só por lib/resumes (hash
// calculado no upload, caminho empresa/pessoa/<sha256>.pdf, sem upsert). O
// mesmo arquivo reaproveita a versão (unique candidateId + sha256).
model CandidateResume {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  candidateId   String    @map("candidate_id") @db.Uuid
  storagePath   String    @unique @map("storage_path")
  sha256        String
  sizeBytes     Int       @map("size_bytes")
  // PUBLIC_FORM | RECRUITER | LEGACY (check constraint no banco)
  source        String
  uploadedById  String?   @map("uploaded_by") @db.Uuid
  // Preenchidos pelo processamento da Fase 3.
  extractedText String?   @map("extracted_text")
  // PENDING | OK | NO_TEXT | INVALID_PDF
  textStatus    String    @default("PENDING") @map("text_status")
  pageCount     Int?      @map("page_count")
  extractedAt   DateTime? @map("extracted_at") @db.Timestamptz(6)
  // Quando deixou de ser a versão atual — base da retenção (lib/resumes/retention.ts).
  supersededAt  DateTime? @map("superseded_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate    Candidate        @relation("CandidateResumes", fields: [candidateId], references: [id], onDelete: Cascade)
  uploadedBy   User?            @relation("ResumeUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  currentFor   Candidate[]      @relation("CandidateCurrentResume")
  applications Application[]    @relation("ApplicationResume")
  analyses     ResumeAnalysis[]

  @@unique([candidateId, sha256], map: "candidate_resumes_candidate_sha256_unique")
  @@index([companyId, candidateId, createdAt(sort: Desc)], map: "idx_candidate_resumes_company_candidate")
  @@map("candidate_resumes")
  @@schema("public")
}

// Uma GERAÇÃO de resumo por IA de uma versão de currículo. Só acrescenta
// (nova geração = linha nova) — o card mostra a mais recente, e o histórico
// alimenta o contador de uso mensal. Nada aqui altera etapa/tag da
// candidatura: a decisão é sempre humana.
model ResumeAnalysis {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  resumeId       String    @map("resume_id") @db.Uuid
  generation     Int
  // PROCESSING | DONE | FAILED | NO_TEXT | SKIPPED
  status         String    @default("PROCESSING")
  // Só com SKIPPED: NO_CONSENT | COMPANY_DISABLED | REAL_DATA_BLOCKED —
  // motivo sobre a FERRAMENTA, nunca sobre o candidato.
  skipReason     String?   @map("skip_reason")
  result         Json?
  // Tags em vigor (começam iguais às da IA; recrutador pode editar).
  skills         String[]  @default([])
  skillsEditedAt DateTime? @map("skills_edited_at") @db.Timestamptz(6)
  skillsEditedById String? @map("skills_edited_by") @db.Uuid
  provider       String?
  model          String?
  isMock         Boolean   @default(false) @map("is_mock")
  errorCode      String?   @map("error_code")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  resume         CandidateResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  skillsEditedBy User?           @relation("AnalysisSkillsEditedBy", fields: [skillsEditedById], references: [id], onDelete: SetNull)

  @@unique([resumeId, generation], map: "resume_analyses_resume_generation_unique")
  @@map("resume_analyses")
  @@schema("public")
}

// Consentimento genérico: finalidade + versão/hash do texto exato exibido.
// Registro de prova — nunca editar; revogar = preencher revokedAt.
//
// Sujeito do consentimento (Fase 2) — EXATAMENTE um dos três deve estar
// preenchido: candidateId (candidato, fluxo original), userId (colaborador
// avulso respondendo algo fora do contexto de um desligamento específico),
// ou employeeExitId (vinculado a UM desligamento, ex. pesquisa de saída).
// O banco só garante "pelo menos um" (constraint consents_has_subject,
// CHECK não dá XOR exato de forma robusta com NULLs) — o XOR de verdade é
// validado na aplicação, ver lib/consent.ts (assertConsentSubject), usado
// por todo código que cria um Consent.
model Consent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  candidateId    String?   @map("candidate_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  employeeExitId String?   @map("employee_exit_id") @db.Uuid
  applicationId  String?   @map("application_id") @db.Uuid
  // APPLICATION_PROCESSING | AI_SCREENING | EXIT_SURVEY_AI_ANALYSIS | …
  // (validado no Zod/lib/ai/availability.ts)
  purpose        String
  textVersion    String    @map("text_version")
  textHash       String    @map("text_hash")
  source         String
  grantedAt      DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate   Candidate?    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user        User?         @relation("ConsentUser", fields: [userId], references: [id], onDelete: Cascade)
  employeeExit EmployeeExit? @relation(fields: [employeeExitId], references: [id], onDelete: Cascade)
  application Application?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  exitSurveyResponses ExitSurveyResponse[]

  @@index([companyId, candidateId, purpose], map: "idx_consents_company_candidate_purpose")
  @@index([companyId, userId, purpose], map: "idx_consents_company_user_purpose")
  @@index([companyId, employeeExitId, purpose], map: "idx_consents_company_exit_purpose")
  @@map("consents")
  @@schema("public")
}

// Histórico cronológico de uma candidatura — mudança de etapa, nota
// adicionada, e-mail enviado (Fase 1) etc. payload guarda detalhes
// específicos do tipo (ex.: STAGE_CHANGED: {from, to}), sem schema fixo por
// tipo (validado no Zod na hora de gravar, não no banco).
model ApplicationEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  type          String
  payload       Json?
  // null = evento gerado pelo sistema (ex.: candidatura pública), não por
  // uma ação de um usuário logado.
  actorId       String?  @map("actor_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?       @relation("ApplicationEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, applicationId])
  @@index([companyId, createdAt])
  @@map("application_events")
  @@schema("public")
}

model TrainingTrail {
