// Registro de desligamento. Guarda uma "foto" do colaborador (nome, cargo,
// departamento, data de admissão) porque o cadastro pode ser excluído de
// verdade depois (users.id → on delete set null) e o histórico de turnover
// precisa sobreviver a isso pros KPIs de Gestão.
model EmployeeExit {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  userId         String?   @unique @map("user_id") @db.Uuid
  userName       String    @map("user_name")
  department     String?
  position       String?
  admissionDate  DateTime? @map("admission_date") @db.Date
  exitDate       DateTime  @map("exit_date") @db.Date
  exitType       String    @map("exit_type")
  reason         String
  notes          String?
  rehireEligible Boolean?  @map("rehire_eligible")
  createdById    String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  dataSource  String  @default("manual") @map("data_source")
  externalRef String? @map("external_ref")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?   @relation("ExitUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("ExitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  consents  Consent[]
  surveyResponse ExitSurveyResponse?

  @@index([companyId, exitDate])
  @@map("employee_exits")
  @@schema("public")
}

// Pesquisa de desligamento nativa (Fase 3) — 1:1 com EmployeeExit, mesmo
// mecanismo de token/expiração de DiscResponse/QuizResponse (token único,
// 7 dias, submittedAt marca resposta única). consentId só é preenchido se
// o respondente consentir com a análise por IA do comentário livre
// (EXIT_SURVEY_AI_ANALYSIS_CONSENT_PURPOSE, Fase 2) — sem consentimento,
// o comentário fica salvo mas nunca entra na análise da Fase 5.
model ExitSurveyResponse {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  employeeExitId String    @unique @map("employee_exit_id") @db.Uuid
  token          String    @unique
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  submittedAt    DateTime? @map("submitted_at") @db.Timestamptz(6)

  leaderName               String?  @map("leader_name")
  environmentScore         Int?     @map("environment_score") @db.SmallInt
  leaderRelationshipScore  Int?     @map("leader_relationship_score") @db.SmallInt
  growthScore              Int?     @map("growth_score") @db.SmallInt
  benefitsScore            Int?     @map("benefits_score") @db.SmallInt
  communicationScore       Int?     @map("communication_score") @db.SmallInt
  biggestChallenge         String?  @map("biggest_challenge")
  improvementSuggestion    String?  @map("improvement_suggestion")
  wouldReturn              Boolean? @map("would_return")
  wouldRecommend           Boolean? @map("would_recommend")
  freeComment              String?  @map("free_comment")

  consentId String? @map("consent_id") @db.Uuid

  // Preparação pra integração futura com ERP — não implementado agora.
  dataSource  String  @default("manual") @map("data_source")
  externalRef String? @map("external_ref")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeExit EmployeeExit @relation(fields: [employeeExitId], references: [id], onDelete: Cascade)
  consent     Consent?     @relation(fields: [consentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("exit_survey_responses")
  @@schema("public")
}

// Título customizado de uma coluna do Kanban de candidatos (a chave do
// estágio — TRIAGE/INTERVIEW/PROPOSAL/HIRED — continua fixa em todo o
// sistema; só o rótulo exibido muda por empresa).
model KanbanStageLabel {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  stage     String
  label     String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, stage])
  @@map("kanban_stage_labels")
  @@schema("public")
}

// Documento anexado à ficha do colaborador (contrato, atestado, exame etc.).
// fileUrl guarda o path no Supabase Storage, não o binário — upload real
// (bucket + action + UI) ainda não implementado, mesmo gap de
// Candidate.resumePath.
model EmployeeDocument {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  // Validar no Zod: CONTRATO | ATESTADO | COMPROVANTE_RESIDENCIA | EXAME_ASO
  // | RG | CPF | CTPS | FOTO_PERFIL | OUTRO — sem enum de banco (padrão do projeto)
  type     String
  fileName String @map("file_name")
  fileUrl  String @map("file_url")

  issueDate      DateTime? @map("issue_date") @db.Date
  expirationDate DateTime? @map("expiration_date") @db.Date
  notes          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId])
  @@index([companyId, expirationDate])
  @@map("employee_documents")
  @@schema("public")
}

// Avisos operacionais da empresa, exibidos no sininho do topo do dashboard
// (ex.: candidatura recebida). Sem userId — visível pra quem tem acesso a
// Recrutamento (ADMIN/HR) na empresa, não por pessoa.
model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid

  // Validar no Zod: CANDIDATE_APPLIED — único tipo por ora
  type    String
  title   String
  message String
  link    String?
  read    Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, read])
  @@map("notifications")
  @@schema("public")
}

// Fila de tarefas em segundo plano (e-mail na Fase 1, triagem com IA na
// Fase 3). NÃO confundir com Job (vaga). Enfileirar/processar sempre via
// lib/tasks — as queries de bloqueio (FOR UPDATE SKIP LOCKED) são SQL cru lá;
// este model é usado só pela leitura da tela de Configurações e pelo
// "Tentar novamente".
model BackgroundTask {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // null = tarefa do sistema, sem empresa
  companyId      String?   @map("company_id") @db.Uuid
  type           String
  payload        Json      @default("{}")
  // pending | running | done | failed (check constraint no banco)
  status         String    @default("pending")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  // Reagendamentos por erro temporário (ex.: 429) — não consomem attempts.
  deferrals      Int       @default(0)
  runAt          DateTime  @default(now()) @map("run_at") @db.Timestamptz(6)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy       String?   @map("locked_by")
  lastError      String?   @map("last_error")
  idempotencyKey String?   @unique @map("idempotency_key")
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status, updatedAt(sort: Desc)], map: "idx_background_tasks_company_status")
  @@map("background_tasks")
  @@schema("public")
}

// Fase 1: Comunicação & Engajamento

model EmailTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  subject   String
  bodyHtml  String   @map("body_html")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logs    EmailLog[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("email_templates")
  @@schema("public")
}

model EmailLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId    String   @map("application_id") @db.Uuid
  templateId       String   @map("template_id") @db.Uuid
  recipientEmail   String   @map("recipient_email")
  subject          String
  bodyHtml         String   @map("body_html")
  status           String   @default("queued")
  sentAt           DateTime? @map("sent_at") @db.Timestamptz(6)
  errorMessage     String?  @map("error_message")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
