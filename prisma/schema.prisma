}

model Interview {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId   String   @unique @map("application_id") @db.Uuid
  scheduledAt     DateTime @map("scheduled_at") @db.Timestamptz(6)
  scheduledBy     String   @map("scheduled_by") @db.Uuid
  status          String   @default("SCHEDULED")
  notes           String?
  modality        String   @default("PRESENCIAL") // "PRESENCIAL" ou "REMOTO"
  interviewerName String?  @map("interviewer_name")
  guests          String?  // JSON array serializado: ["João Silva", "Maria Santos"]
  interviewLink   String?  @map("interview_link") // Meet/Teams/Zoom — preenchido à parte, dispara e-mail próprio
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([scheduledAt])
  @@map("interviews")
  @@schema("public")
}

// Avaliação comportamental DISC (2 partes, 60 afirmações fixas, escala
// Likert 1-5) — ÚNICO tipo de avaliação do sistema (o sistema genérico de
// assessments/AssessmentQuestion/etc. foi removido por completo — migration
// 0035 dropa as 5 tabelas). Ver lib/disc/calculate.ts pra fórmula de score.
model DiscAssessment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  title     String   @default("Avaliação Comportamental")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  questions DiscQuestion[]
  responses DiscResponse[]

  @@index([companyId])
  @@map("disc_assessments")
  @@schema("public")
}

// Uma das 60 afirmações fixas — sem CRUD, populadas via script de seed
// (lib/disc/questions.ts) na criação do DiscAssessment de cada empresa.
model DiscQuestion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  position     Int
  // "COMPETENCIAS" (posições 1-36) ou "DISC" (posições 37-60).
  section      String
  // Energia/Responsabilidade/Engajamento/Trabalho em Equipe/Comprometimento/
  // Facilidade de Aprendizagem (COMPETENCIAS) ou D/I/S/C (DISC).
  dimension    String
  text         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  assessment DiscAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers    DiscAnswer[]

  @@index([assessmentId])
  @@map("disc_questions")
  @@schema("public")
}

// Uma tentativa (candidato x assessment) — acessada via token público, mesmo
// modelo de link único + expiração do AssessmentResponse genérico. Scores
// ficam null até submitted_at ser preenchido.
model DiscResponse {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  assessmentId  String    @map("assessment_id") @db.Uuid
  token         String    @unique
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  submittedAt   DateTime? @map("submitted_at") @db.Timestamptz(6)

  scoreEnergia          Decimal? @map("score_energia") @db.Decimal(5, 2)
  scoreResponsabilidade Decimal? @map("score_responsabilidade") @db.Decimal(5, 2)
  scoreEngajamento      Decimal? @map("score_engajamento") @db.Decimal(5, 2)
  scoreTrabalhoEquipe   Decimal? @map("score_trabalho_equipe") @db.Decimal(5, 2)
  scoreComprometimento  Decimal? @map("score_comprometimento") @db.Decimal(5, 2)
  scoreAprendizagem     Decimal? @map("score_aprendizagem") @db.Decimal(5, 2)
  scoreGeral            Decimal? @map("score_geral") @db.Decimal(5, 2)
  nivelGeral            String?  @map("nivel_geral")

  scoreD     Decimal? @map("score_d") @db.Decimal(5, 2)
  scoreI     Decimal? @map("score_i") @db.Decimal(5, 2)
  scoreS     Decimal? @map("score_s") @db.Decimal(5, 2)
  scoreC     Decimal? @map("score_c") @db.Decimal(5, 2)
  perfilDisc String?  @map("perfil_disc")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  application Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assessment  DiscAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers     DiscAnswer[]

  @@unique([applicationId, assessmentId])
  @@index([token])
  @@index([applicationId])
  @@index([companyId])
  @@map("disc_responses")
  @@schema("public")
}

// Nota (1-5) do candidato numa das 60 afirmações.
model DiscAnswer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  responseId String   @map("response_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  score      Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  response DiscResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question DiscQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([responseId])
  @@index([companyId])
  @@map("disc_answers")
  @@schema("public")
}

// Banner de parceiro na tela de Início — global (sem companyId, ao contrário
// do resto do schema), gerido só por SUPERADMIN (/admin/parceiros).
model Partner {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  imageUrl  String   @map("image_url")
  linkUrl   String   @map("link_url")
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([active, position])
  @@map("partners")
  @@schema("public")
}

// "Avaliações" — segundo tipo além de DISC, ao lado dele em /avaliacoes.
// scored=true: múltipla escolha com gabarito, resultado "N/M pts" (decisão
// de produto: reconstrói o cálculo do sistema genérico removido na migration
// 0035, mas desta vez integrado na mesma tela de gestão que o DISC, não
// duplicado). scored=false: só coleta a escolha, sem certo/errado/nota —
// mesmas tabelas, is_correct nas choices e score nas answers ficam sem uso.
model QuizAssessment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  title     String
  scored    Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  responses QuizResponse[]

  @@index([companyId])
  @@map("quiz_assessments")
  @@schema("public")
}

model QuizQuestion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  position     Int
  text         String
  maxScore     Int      @default(1) @map("max_score")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  assessment QuizAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  choices    QuizChoice[]
  answers    QuizAnswer[]

  @@index([assessmentId, position])
  @@map("quiz_questions")
  @@schema("public")
}

model QuizChoice {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  position   Int
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAnswer[]

  @@index([questionId, position])
  @@map("quiz_choices")
  @@schema("public")
}

model QuizResponse {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  assessmentId  String    @map("assessment_id") @db.Uuid
  token         String    @unique
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  submittedAt   DateTime? @map("submitted_at") @db.Timestamptz(6)
  score         Int?
  maxScore      Int?      @map("max_score")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  application Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assessment  QuizAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@unique([applicationId, assessmentId])
  @@index([token])
  @@index([applicationId])
  @@index([companyId])
  @@map("quiz_responses")
  @@schema("public")
}

model QuizAnswer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  responseId String   @map("response_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  choiceId   String   @map("choice_id") @db.Uuid
  score      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  response QuizResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choice   QuizChoice   @relation(fields: [choiceId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([responseId])
  @@map("quiz_answers")
  @@schema("public")
}
